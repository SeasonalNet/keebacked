# Copy to .env and replace every host path before running Docker Compose.
KEEBACKED_IMAGE=keebacked:dev
KEEBACKED_VERSION=dev
KEEBACKED_CONFIG_FILE=./config/keebacked.toml
KEEBACKED_SOURCE_DIRECTORY=/absolute/path/to/directory-containing-vault
KEEBACKED_PRIMARY_TARGET=/absolute/path/to/primary-target
KEEBACKED_OFFLINE_TARGET=/absolute/path/to/offline-target
KEEBACKED_UID=1000
KEEBACKED_GID=1000

# Optional build provenance overrides used by `docker compose build`.
KEEBACKED_COMMIT=unknown
KEEBACKED_COMMIT_TIME=unknown
KEEBACKED_MODIFIED=unknown
KEEBACKED_BUILD_DATE=unknown
KEEBACKED_BUILT_BY=unknown
KEEBACKED_BUILD_HOST_OS=unknown
KEEBACKED_BUILD_HOST_KERNEL=unknown
KEEBACKED_SOURCE_URL=https://git.seasonalnet.org/SeasonalNet/keebacked
